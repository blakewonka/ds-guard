{
  "name": "BirDS Guard",
  "id": "birds-guard-dev",
  "api": "1.0.0",
  "main": "dist/code.js",
  "ui": "dist/ui.html",
  "editorType": ["figma", "dev"],
  "capabilities": ["inspect"],
